{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "description": "Auto merge minor and patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Block major updates from auto merge",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 3am on Monday"
    ]
  },
  "vulnerabilityAlerts": {
    "automerge": true
  },
  "schedule": [
    "before 3am on Monday"
  ],
  "timezone": "UTC",
  "dependencyDashboard": true
}
